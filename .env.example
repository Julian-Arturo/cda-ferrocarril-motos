# Canal principal de atención y agendamiento (WhatsApp con código de país, sin '+' ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=573042950489

# Analítica y telemetría (Opcional - Google Analytics 4 / Google Tag Manager)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
